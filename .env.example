# ---- Runtime -----------------------------------------------------------
NODE_ENV=development
# Shared by the API and the web app. Change this in any real deployment.
SESSION_SECRET=dev-only-insecure-session-secret-change-me

# ---- API ---------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=4000
API_ORIGIN=http://127.0.0.1:4000

# ---- Database ----------------------------------------------------------
# Leave DATABASE_URL empty to use the embedded PGlite database (file-backed,
# zero-install) which is the default for local development and tests.
# Set it to a real PostgreSQL connection string to use a real server instead —
# the SQL is identical.
# DATABASE_URL=postgres://user:password@localhost:5432/ecosystem_os
PGLITE_DATA_DIR=.data/pgdata

# ---- Auth --------------------------------------------------------------
# dev  = local demo login (pick a seeded user). Never enabled in production
#        unless ALLOW_DEV_LOGIN_IN_PRODUCTION=true.
# oidc = real OIDC identity provider (Auth0/Keycloak/...).
AUTH_MODE=dev
# ALLOW_DEV_LOGIN_IN_PRODUCTION=false

OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/auth/oidc/callback
OIDC_SCOPES=openid email profile

# ---- Web ---------------------------------------------------------------
NEXT_ALLOWED_ORIGINS=
