{
  "name": "ecosystem-os",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Company X Ecosystem Platform — Self-Governing Ecosystem operating system",
  "engines": {
    "node": ">=20.10.0"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch --clear-screen=false server/index.ts",
    "dev:web": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "db:migrate": "tsx db/migrate.ts",
    "db:seed": "tsx db/seed.ts",
    "db:reset": "tsx db/reset.ts",
    "db:studio": "tsx db/inspect.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "typecheck": "tsc --noEmit",
    "lint": "next lint --dir app --dir components --dir lib",
    "check": "npm run typecheck && npm run test"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.0",
    "fastify": "5.12.4",
    "jose": "6.2.12",
    "next": "15.5.25",
    "pg": "8.23.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.18.9",
    "@types/pg": "8.15.6",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "autoprefixer": "10.4.21",
    "concurrently": "9.2.1",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.25",
    "fast-check": "4.10.0",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.19",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
